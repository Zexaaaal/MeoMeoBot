    {
     "key": "margin-bottom",
     "type": "slider",
     "label": "Marge sous pseudo",
     "default": 4,
     "min": 0,
     "max": 20,
     "unit": "px"
    },
    {
     "key": "text-shadow",
     "type": "text-shadow",
     "label": "Ombre du texte",
     "default": "none"
    },
    {
     "key": "text-transform",
