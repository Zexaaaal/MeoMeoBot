      {
       "label": "Pointillée",
       "value": "dashed"
      },
      {
       "label": "Points",
       "value": "dotted"
      },
      {
       "label": "Double",
       "value": "double"
      }
     ]
    },
    {
     "key": "border-width",
     "type": "slider",
     "label": "Épaisseur bordure",
     "default": 1,
     "min": 0,
     "max": 10,
     "unit": "px"
    },
    {
     "key": "border-color",
     "type": "color-alpha",
     "label": "Couleur bordure",
     "default": "rgba(255, 255, 255, 0.08)"
    },
    {
     "key": "padding",
     "type": "slider",
     "label": "Padding",
     "default": 10,
     "min": 0,
     "max": 40,
     "unit": "px"
    },
    {
     "key": "margin-bottom",
     "type": "slider",
     "label": "Marge inférieure",
     "default": 0,
     "min": 0,
     "max": 30,
     "unit": "px"
    },
    {
     "key": "backdrop-filter",
     "type": "blur",
     "label": "Flou arrière-plan",
     "default": 0,
     "max": 30
    },
    {
     "key": "box-shadow",
     "type": "box-shadow",
     "label": "Ombre",
     "default": "none"
    },
    {
     "key": "animation-name",
     "type": "select",
     "label": "Animation",
     "default": "slideInBottom",
     "options": [
      {
       "label": "Aucune",
       "value": "none"
      },
      {
       "label": "Glisser du bas",
       "value": "slideInBottom"
      },
      {
       "label": "Glisser du haut",
       "value": "slideInTop"
      },
      {
       "label": "Glisser de gauche",
       "value": "slideInLeft"
      },
      {
       "label": "Glisser de droite",
       "value": "slideInRight"
      },
      {
       "label": "Fondu",
       "value": "fadeIn"
      },
      {
       "label": "Zoom",
       "value": "zoomIn"
      },
      {
       "label": "Rebond",
       "value": "bounceIn"
      }
     ]
    },
    {
     "key": "animation-duration",
     "type": "slider",
     "label": "Durée animation",
     "default": 0.3,
     "min": 0.1,
     "max": 2,
     "step": 0.1,
     "unit": "s"
    },
    {
     "key": "--user-color-bg",
     "type": "toggle",
     "label": "Fond dépendant couleur pseudo",
     "default": false
    }
   ]
  },
  {
