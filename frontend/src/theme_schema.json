{
 "chat": [
  {
   "label": "Conteneur",
   "selector": "#chat-container",
   "props": [
    {
     "key": "padding",
     "type": "spacing",
     "label": "Padding",
     "default": "10px 10px 24px 10px"
    },
    {
     "key": "gap",
     "type": "slider",
     "label": "Espacement",
     "default": 10,
     "min": 0,
     "max": 40,
     "unit": "px"
    },
    {
     "key": "justify-content",
     "type": "select",
     "label": "Position verticale",
     "default": "flex-end",
     "options": [
      {
       "label": "En bas",
       "value": "flex-end"
      },
      {
       "label": "En haut",
       "value": "flex-start"
      },
      {
       "label": "Centré",
       "value": "center"
      }
     ]
    }
   ]
  },
  {
   "label": "Bloc de messages",
   "selector": ".msg-group",
